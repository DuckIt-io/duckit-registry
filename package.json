{
  "name": "duckit-registry",
  "version": "0.0.0",
  "private": true,
  "description": "Duckit Registry — Modern component registry platform for React ecosystem",
  "workspaces": [
    "packages/*",
    "registry"
  ],
  "scripts": {
    "build": "npm -w @duckit/cli run build",
    "dev": "npm -w @duckit/cli run dev",
    "lint": "tsc --noEmit && prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-registry": "npm -w @duckit/cli run generate-registry",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "publish:registry": "npm -w @duckit/registry publish --access public",
    "version:registry": "npm -w @duckit/registry version patch",
    "publish:cli": "npm -w @duckit/cli publish --access public",
    "version:cli": "npm -w @duckit/cli version patch"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "prettier": "^3.4.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}
